#include <stdio.h>

int main() {
    int m, n, rowsB, p;

    scanf("%d %d", &m, &n);

    int A[m][n];

    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &A[i][j]);
        }
    }

    scanf("%d %d", &rowsB, &p);

    // Matrix multiplication is possible only if n == rowsB
    if (n != rowsB) {
        printf("Invalid input");
        return 0;
    }

    int B[rowsB][p];

    for (int i = 0; i < rowsB; i++) {
        for (int j = 0; j < p; j++) {
            scanf("%d", &B[i][j]);
        }
    }

    // Calculate and print result
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < p; j++) {
            int sum = 0;

            for (int k = 0; k < n; k++) {
                sum += A[i][k] * B[k][j];
            }

            printf("%d ", sum);
        }
        printf("\n");
    }

    return 0;
}

